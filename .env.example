# ==========================================
# KHQR Daily Report Telegram Bot Configuration
# ==========================================

# 1. Telegram API Credentials
# យក API_ID និង API_HASH ពីគេហទំព័រផ្លូវការ: https://my.telegram.org (ចូល Development Tools)
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_api_hash_here

# 2. Telegram Bot Token (បង្កើតតាមរយៈ @BotFather)
# ប្រើសម្រាប់ Bot Mode (ឆ្លើយតប Command: /today, /report...)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 3. លេខទូរសព្ទ Telegram (សម្រាប់ Userbot Mode - អាចអានសារពី Bank Bot ក្នុង Group បាន ១០០%)
# ឧទាហរណ៍: +85512345678
TELEGRAM_PHONE_NUMBER=+855XXXXXXXX

# 4. Telegram Group ID ដែល Bank Bot (ABA Merchant) ផ្ញើសារចូល
# (អាចមើលតាមរយៈ Rose bot វាយ /id ឬ bot ផ្សេងទៀត)
# ឧទាហរណ៍: -1001234567890 ឬទុកទទេដើម្បី monitor គ្រប់ chat ដែលអានបាន
MONITOR_CHAT_ID=-1001234567890

# 5. Telegram Chat/Group ID សម្រាប់ទទួលរបាយការណ៍បូកសរុប (Daily Report)
# អាចជារបស់ Admin ឬ Group រួម
REPORT_CHAT_ID=-1001234567890

# 6. ម៉ោងផ្ញើរបាយការណ៍បូកសរុបប្រចាំថ្ងៃស្វ័យប្រវត្តិ (ម៉ោងនៅកម្ពុជា UTC+7)
# ឧទាហរណ៍: 22:00 (ម៉ោង ១០ យប់)
DAILY_REPORT_TIME=22:00

# 7. បើក/បិទ ការផ្ញើសារ Alert ភ្លាមៗពេលមានការទូទាត់ចូល (true ឬ false)
ENABLE_INSTANT_ALERT=false

# 9. ការពារសុវត្ថិភាពកម្រិតខ្ពស់ (High Security & Permission Control)
# កំណត់ Telegram User ID របស់ម្ចាស់ (Admin/Owner) ដែលមានសិទ្ធិពេញលេញ
# អាចដឹង ID ខ្លួនឯងតាមរយៈវាយ /id ទៅកាន់ @userinfobot ឬ Rose bot
# បើមានច្រើន អាចដាក់ក្បៀស (ឧ. 12345678,87654321)
ADMIN_USER_IDS=12345678

# កំណត់ថាតើត្រូវទាមទារសិទ្ធិអនុញ្ញាតទើបអាចមើលរបាយការណ៍បាន (true ឬ false)
# បើ true: អ្នកផ្សេងក្នុង Group ចុចមើលរបាយការណ៍មិនបានទេ ប្រសិនបើគ្មានការអនុញ្ញាតពីអ្នក
RESTRICT_REPORTS_TO_ADMIN=true

# 10. ឈ្មោះ Database ផ្ទុកទិន្នន័យ
DB_PATH=khqr_reports.db
